{
  "version": 1,
  "tool": "scene-animator",
  "name": "First Retrowave Scene",
  "method": "base-scenery-plus-aligned-still-frames-flipbook",
  "dimensions": { "width": 1600, "height": 900 },
  "base": { "file": "base-scene.svg" },
  "frames": [
    { "order": 1, "file": "frames/frame-01.svg", "hold": 140 },
    { "order": 2, "file": "frames/frame-02.svg", "hold": 140 },
    { "order": 3, "file": "frames/frame-03.svg", "hold": 140 },
    { "order": 4, "file": "frames/frame-04.svg", "hold": 140 }
  ],
  "loop": true,
  "archive": {
    "fullResolutionPngPack": "first-retrowave-scene.zip",
    "expectedPngFiles": [
      "base-scene.png",
      "frames/frame-01.png",
      "frames/frame-02.png",
      "frames/frame-03.png",
      "frames/frame-04.png",
      "mockup/scene-animator-first-scene-mockup.png"
    ]
  },
  "notes": "Runtime SVG set is committed for GitHub Pages. The downloadable source pack contains the full-resolution PNG art and approved mockup."
}
