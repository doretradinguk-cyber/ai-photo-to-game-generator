{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doretrading.uk/schemas/photo-to-game/preset.schema.json",
  "title": "AI Photo-to-Game Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "controls", "browserRecipe"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "controls": { "$ref": "#/$defs/controls" },
    "browserRecipe": {
      "type": "object",
      "additionalProperties": true
    },
    "providerHints": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "zeroToHundred": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styleStrength", "detail", "contrast", "glow", "edgeClean", "skinToneLock", "backgroundBlend"],
      "properties": {
        "styleStrength": { "$ref": "#/$defs/zeroToHundred" },
        "detail": { "$ref": "#/$defs/zeroToHundred" },
        "contrast": { "$ref": "#/$defs/zeroToHundred" },
        "glow": { "$ref": "#/$defs/zeroToHundred" },
        "edgeClean": { "$ref": "#/$defs/zeroToHundred" },
        "skinToneLock": { "$ref": "#/$defs/zeroToHundred" },
        "backgroundBlend": { "$ref": "#/$defs/zeroToHundred" }
      }
    }
  }
}
